# Copy this file to .env and fill in your own keys:
#   cp .env.example .env
#
# .env is gitignored - never commit real keys.
#
# On a host (Render, Vercel, Fly, Railway, Streamlit Cloud) do NOT ship a .env
# file. Set these same two names as environment variables in the dashboard;
# the app reads real environment variables first and .env only as a fallback.

PINECONE_API_KEY=your-pinecone-api-key
GROQ_API_KEY=your-groq-api-key
