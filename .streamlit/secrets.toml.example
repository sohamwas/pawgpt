# Copy this file to .streamlit/secrets.toml and fill in your own keys.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml is gitignored - never commit real keys.
# On Streamlit Community Cloud, paste these same two lines into
# Settings -> Secrets instead of creating the file.
#
# The app also accepts these as environment variables (PINECONE_API_KEY /
# GROQ_API_KEY), which is what you want on Render, Fly, Railway, etc.

pinecone_api_key = "your-pinecone-api-key"
groq_api_key = "your-groq-api-key"
